rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'accountant', 'secretary'];
    }

    function isAccountingStaff() {
      return isAuthenticated() && request.auth.token.role in ['admin', 'accountant'];
    }

    function callerCabinetId() {
      return request.auth.token.cabinetId;
    }

    function clientPath(clientId) {
      return /databases/(default)/documents/clients/$(clientId);
    }

    function clientBelongsToCallerCabinet(clientId) {
      return isStaff()
        && callerCabinetId() != null
        && firestore.exists(clientPath(clientId))
        && firestore.get(clientPath(clientId)).data.cabinetId == callerCabinetId();
    }

    function canAccessClientFiles(clientId) {
      return isAuthenticated()
        && (request.auth.uid == clientId || isAdmin() || clientBelongsToCallerCabinet(clientId));
    }

    function isAccountingDocumentUpload() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
        );
    }

    function isLogoUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /mails/{clientId}/{allPaths=**} {
      allow get: if canAccessClientFiles(clientId);
      allow list: if isStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
      allow create, update: if false;
      allow delete: if isAccountingStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
    }

    match /exports/{clientId}/{allPaths=**} {
      allow get: if canAccessClientFiles(clientId);
      allow list: if isAccountingStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
      allow create, update, delete: if false;
    }

    match /cabinets/{cabinetId}/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin() || (isStaff() && callerCabinetId() == cabinetId);
      allow create, update: if (isAdmin() || (isStaff() && callerCabinetId() == cabinetId))
        && isLogoUpload();
      allow delete: if isAdmin() || (isStaff() && callerCabinetId() == cabinetId);
    }

    match /vault/{clientId}/{allPaths=**} {
      allow get: if canAccessClientFiles(clientId);
      allow list: if isStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
      allow create, update: if canAccessClientFiles(clientId) && isAccountingDocumentUpload();
      allow delete: if canAccessClientFiles(clientId);
    }

    match /{clientId}/{allPaths=**} {
      allow get: if canAccessClientFiles(clientId);
      allow list: if isStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
      allow create, update: if canAccessClientFiles(clientId) && isAccountingDocumentUpload();
      allow delete: if isAccountingStaff() && (isAdmin() || clientBelongsToCallerCabinet(clientId));
    }
  }
}
