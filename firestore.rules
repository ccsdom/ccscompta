rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/clients/$(userId);
    }

    function getProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function callerRole() {
      return request.auth.token.role;
    }

    function callerCabinetId() {
      return request.auth.token.cabinetId;
    }

    function isAdmin() {
      return isAuthenticated() && callerRole() == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && callerRole() in ['admin', 'accountant', 'secretary'];
    }

    function isAccountingStaff() {
      return isAuthenticated() && callerRole() in ['admin', 'accountant'];
    }

    function isOwner(clientId) {
      return isAuthenticated() && request.auth.uid == clientId;
    }

    function isCabinetStaff(cabinetId) {
      return isAdmin() || (isStaff() && callerCabinetId() == cabinetId);
    }

    function isCabinetAccountingStaff(cabinetId) {
      return isAdmin() || (isAccountingStaff() && callerCabinetId() == cabinetId);
    }

    function clientBelongsToCabinet(clientId, cabinetId) {
      return exists(profilePath(clientId)) && get(profilePath(clientId)).data.cabinetId == cabinetId;
    }

    function canReadClientScoped(clientId, cabinetId) {
      return isOwner(clientId)
        || isCabinetStaff(cabinetId)
        || (isStaff() && clientBelongsToCabinet(clientId, callerCabinetId()));
    }

    function canCreateClientScoped(clientId, cabinetId) {
      return (isOwner(clientId) && getProfile().cabinetId == cabinetId)
        || (isCabinetStaff(cabinetId) && clientBelongsToCabinet(clientId, cabinetId));
    }

    function clientIdentityUnchanged() {
      return request.resource.data.clientId == resource.data.clientId
        && request.resource.data.cabinetId == resource.data.cabinetId;
    }

    function protectedClientFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'cabinetId', 'isCabinetAdmin', 'stripeCustomerId', 'stripeSubscriptionId', 'stripeSubscriptionItemId']);
    }

    // Global system admins are isolated through custom claims only.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /clients/{userId} {
      allow get: if isOwner(userId) || isCabinetStaff(resource.data.cabinetId);
      allow list: if isStaff() && (isAdmin() || resource.data.cabinetId == callerCabinetId());
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == 'client'
        && !('cabinetId' in request.resource.data);
      allow update: if (isOwner(userId) && protectedClientFieldsUnchanged())
        || (
          isCabinetStaff(resource.data.cabinetId)
          && protectedClientFieldsUnchanged()
        );
      allow delete: if false;
    }

    match /documents/{docId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if canCreateClientScoped(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId)
        && clientIdentityUnchanged();
      allow delete: if isCabinetStaff(resource.data.cabinetId);
    }

    match /invoices/{invoiceId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if canCreateClientScoped(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId)
        && clientIdentityUnchanged();
      allow delete: if isCabinetStaff(resource.data.cabinetId);
    }

    match /bilans/{bilanId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if canCreateClientScoped(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if isCabinetAccountingStaff(resource.data.cabinetId) && clientIdentityUnchanged();
      allow delete: if isCabinetAccountingStaff(resource.data.cabinetId);
    }

    match /reconciliations/{reconcId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId)
        || isCabinetStaff(resource.data.cabinetId);
      allow list: if isCabinetStaff(resource.data.cabinetId);
      allow create: if isCabinetAccountingStaff(request.resource.data.cabinetId);
      allow update: if isCabinetAccountingStaff(resource.data.cabinetId)
        && request.resource.data.cabinetId == resource.data.cabinetId;
      allow delete: if isCabinetAccountingStaff(resource.data.cabinetId);
    }

    match /assets/{assetId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if isCabinetAccountingStaff(request.resource.data.cabinetId)
        && clientBelongsToCabinet(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if isCabinetAccountingStaff(resource.data.cabinetId)
        && clientIdentityUnchanged();
      allow delete: if isCabinetAccountingStaff(resource.data.cabinetId);
    }

    match /accounting_entries/{entryId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if isCabinetAccountingStaff(request.resource.data.cabinetId)
        && clientBelongsToCabinet(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if isCabinetAccountingStaff(resource.data.cabinetId)
        && resource.data.status != 'exported'
        && clientIdentityUnchanged();
      allow delete: if isCabinetAccountingStaff(resource.data.cabinetId)
        && resource.data.status != 'exported';
    }

    match /fec_exports/{exportId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if isCabinetAccountingStaff(request.resource.data.cabinetId)
        && clientBelongsToCabinet(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update, delete: if false;
    }

    match /fiscal_years/{yearId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if isCabinetAccountingStaff(request.resource.data.cabinetId)
        && clientBelongsToCabinet(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update: if isCabinetAccountingStaff(resource.data.cabinetId)
        && clientIdentityUnchanged();
      allow delete: if isCabinetAccountingStaff(resource.data.cabinetId)
        && resource.data.isClosed != true;
    }

    match /notifications/{notifId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if isStaff();
      allow update: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow delete: if false;
    }

    match /mails/{mailId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if isStaff() && (isAdmin() || resource.data.cabinetId == callerCabinetId());
      allow create: if isStaff();
      allow update, delete: if isStaff() && (isAdmin() || resource.data.cabinetId == callerCabinetId());
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /emails/{emailId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /cabinets/{cabinetId} {
      allow get: if isAdmin() || isCabinetStaff(cabinetId);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isCabinetStaff(cabinetId) && request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    match /bank_connections/{connectionId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if canCreateClientScoped(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update, delete: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId)
        && clientIdentityUnchanged();
    }

    match /sales_invoices/{invoiceId} {
      allow get: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow list: if canReadClientScoped(resource.data.clientId, resource.data.cabinetId);
      allow create: if canCreateClientScoped(request.resource.data.clientId, request.resource.data.cabinetId);
      allow update, delete: if isOwner(resource.data.clientId) && clientIdentityUnchanged();
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
